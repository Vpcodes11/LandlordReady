{
  "name": "landlord-ready",
  "version": "1.0.0",
  "description": "Compliance autopilot for small private landlords in England",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev\"",
    "start": "node server/server.js"
  },
  "keywords": [
    "landlord",
    "compliance",
    "renters-rights-act",
    "england",
    "property-management"
  ],
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.0"
  }
}
