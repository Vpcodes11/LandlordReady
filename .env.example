# Local: copy to .env. Production: set these on the host (render.yaml lists them).
NODE_ENV=development
PORT=5000
# Public address, no trailing slash (sign-in links, checkout return)
APP_URL=http://localhost:5000
# Where the SQLite database and uploaded certificates are stored. MUST be a persistent disk in production.
DATA_DIR=./data
# Signs login cookies. At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Email (Resend). Without a key in development, sign-in links are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=LandlordReady <hello@yourdomain.co.uk>
# Comma-separated emails allowed to publish regulation updates
ADMIN_EMAILS=
# Dodo Payments (GBP subscriptions). test_mode while testing, live_mode when live.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_ANNUAL=
DODO_PRODUCT_PORTFOLIO_MONTHLY=
DODO_PRODUCT_PORTFOLIO_ANNUAL=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
# /api/health?key=... lists missing settings
HEALTH_KEY=
# Development only: load the fictional demo landlord and portfolio into an empty database
SEED_DEMO=false
